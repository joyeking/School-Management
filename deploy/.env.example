# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# Public hostname of the site (Caddy will get a free TLS certificate for it).
# FREE temporary address: use your server's public IP with sslip.io.
#   IP 203.0.113.7  ->  203-0-113-7.sslip.io   (dashes instead of dots)
# With your own domain later: app.example.com
SITE_ADDRESS=203-0-113-7.sslip.io

# Database credentials (also used by the app container).
DB_NAME=rosariosis
DB_USER=rosario
DB_PASSWORD=change-this-to-a-long-random-password
DB_ROOT_PASSWORD=change-this-too

# RosarioSIS settings
DEFAULT_SYEAR=2025
ETHIOPIAN_CALENDAR=true
ROSARIO_NOTIFY_ADDRESS=
ROSARIO_ERRORS_ADDRESS=
